#!/usr/bin/make -f

# LTO breaks the -Wl,--wrap mocks used by the unit tests (Ubuntu enables it by default).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		--includedir=/usr/include/openvpn \
		--with-crypto-library=openssl \
		--enable-pkcs11 \
		--enable-systemd \
		SYSTEMD_UNIT_DIR=/usr/lib/systemd/system \
		TMPFILES_DIR=/usr/lib/tmpfiles.d

# Only the unit tests: the other "make check" tests need root and /dev/net/tun.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) -C tests/unit_tests check VERBOSE=1
endif

execute_after_dh_auto_install:
	find debian/openvpn -name '*.la' -delete
